
    "%run migraine_clustering_pipeline.ipynb\n",
    "\n",
    "from sklearn.metrics import adjusted_rand_score\n",
    "\n",
    "N_BOOT = 1000\n",
    "K = 2\n",
    "\n",
    "\n",
    "def bootstrap_stability(encoded, method, k=K, B=N_BOOT, seed=SEED):\n",
    "    encoded = np.asarray(encoded, dtype=np.float32)\n",
    "    n = encoded.shape[0]\n",
    "\n",
    "    # Reference solution on the original sample\n",
    "    ref_labels = make_clusterer(method, k, n).fit_predict(encoded)\n",
    "\n",
    "    rng = np.random.RandomState(seed)\n",
    "    aris = []\n",
    "    for b in range(B):\n",
    "        pos = rng.randint(0, n, size=n)\n",
    "        try:\n",
    "            boot_labels = make_clusterer(method, k, n).fit_predict(encoded[pos])\n",
    "        except Exception as e:\n",
    "            print(f\"  [skip b={b}] {type(e).__name__}: {e}\")\n",
    "            continue\n",
    "\n",
    "        # One label per unique subject (first occurrence in the resample)\n",
    "        boot_by_row = {}\n",
    "        for row_id, lab in zip(pos, boot_labels):\n",
    "            if row_id not in boot_by_row:\n",
    "                boot_by_row[row_id] = lab\n",
    "\n",
    "        ids = list(boot_by_row.keys())\n",
    "        aris.append(adjusted_rand_score([ref_labels[i] for i in ids],\n",
    "                                        [boot_by_row[i] for i in ids]))\n",
    "\n",
    "    aris = np.array(aris)\n",
    "    lo, hi = np.percentile(aris, [2.5, 97.5])\n",
    "    return {\"group\": GROUP, \"model\": MODEL, \"method\": method, \"B_done\": len(aris),\n",
    "            \"ari_median\": float(np.median(aris)),\n",
    "            \"ci_low\": float(lo), \"ci_high\": float(hi)}"
   ]
  },
  {
   "cell_type": "code",
