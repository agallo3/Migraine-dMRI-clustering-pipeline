   "source": [
    "rows = []\n",
    "for method in (\"kmeans\", \"agglomerative\", \"spectral\"):\n",
    "    res = bootstrap_stability(pca_feats, method)\n",
    "    rows.append(res)\n",
    "    print(f\"{method:14s}  median={res['ari_median']:.3f} \"\n",
    "          f\"[95% CI {res['ci_low']:.3f}, {res['ci_high']:.3f}]  (B={res['B_done']})\")\n",
    "\n",
    "boot_df = pd.DataFrame(rows)\n",
    "os.makedirs(\"results\", exist_ok=True)\n",
    "boot_df.to_csv(f\"results/bootstrap_{GROUP}_{MODEL}.csv\", index=False)"
   ]
